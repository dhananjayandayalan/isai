{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://isai.local/schema/song.schema.json",
  "title": "Song",
  "description": "One analysed song: tempo, tonality, chords and a playable two-hand arrangement. Contract between pipeline and web (ADR 0002).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "title",
    "sourceType",
    "durationSec",
    "tempo",
    "timeSignature",
    "tonality",
    "chords",
    "notes",
    "meta"
  ],
  "properties": {
    "schemaVersion": {
      "description": "Version of this schema the file was written against. Every supported version is listed, newest last; the pipeline writes the newest (ADR 0008).",
      "enum": ["0.1.0", "0.2.0", "0.3.0"]
    },
    "id": {
      "description": "Stable identifier of the song analysis.",
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "sourceType": {
      "description": "Which pipeline path produced the song.",
      "type": "string",
      "enum": ["piano-solo", "full-mix", "a-cappella", "carnatic"]
    },
    "durationSec": {
      "type": "number",
      "minimum": 0
    },
    "tempo": { "$ref": "#/$defs/Tempo" },
    "timeSignature": { "$ref": "#/$defs/TimeSignature" },
    "tonality": { "$ref": "#/$defs/Tonality" },
    "chords": {
      "type": "array",
      "items": { "$ref": "#/$defs/Chord" }
    },
    "notes": {
      "type": "array",
      "items": { "$ref": "#/$defs/Note" }
    },
    "sections": {
      "type": "array",
      "items": { "$ref": "#/$defs/Section" }
    },
    "meta": { "$ref": "#/$defs/Meta" }
  },
  "$defs": {
    "Tempo": {
      "title": "Tempo",
      "type": "object",
      "additionalProperties": false,
      "required": ["bpm", "beats"],
      "properties": {
        "bpm": {
          "description": "Average tempo in beats per minute.",
          "type": "number",
          "exclusiveMinimum": 0
        },
        "beats": {
          "description": "Beat times in seconds from the start of the audio.",
          "type": "array",
          "items": { "type": "number", "minimum": 0 }
        },
        "downbeats": {
          "description": "Times in seconds of the first beat of each bar, from the start of the audio. Optional; added in 0.2.0.",
          "type": "array",
          "items": { "type": "number", "minimum": 0 }
        }
      }
    },
    "TimeSignature": {
      "title": "TimeSignature",
      "type": "object",
      "additionalProperties": false,
      "required": ["num", "den"],
      "properties": {
        "num": { "type": "integer", "minimum": 1 },
        "den": { "type": "integer", "enum": [2, 4, 8, 16] }
      }
    },
    "Tonality": {
      "title": "Tonality",
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "mode", "scale"],
      "properties": {
        "key": {
          "description": "Tonic note name, e.g. \"G\" or \"Bb\".",
          "type": "string",
          "pattern": "^[A-G](#|b)?$"
        },
        "mode": {
          "type": "string",
          "enum": ["major", "minor", "modal"]
        },
        "tonicHz": {
          "description": "Measured tonic frequency (shruti for Carnatic songs).",
          "type": "number",
          "exclusiveMinimum": 0
        },
        "scale": {
          "description": "Pitch classes of the scale (0 = C), in scale order from the tonic.",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "integer", "minimum": 0, "maximum": 11 }
        },
        "raga": {
          "description": "Raga name, for Carnatic songs.",
          "type": "string",
          "minLength": 1
        }
      }
    },
    "Chord": {
      "title": "Chord",
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end", "root", "quality", "label"],
      "properties": {
        "start": { "type": "number", "minimum": 0 },
        "end": { "type": "number", "minimum": 0 },
        "root": {
          "description": "Root pitch class (0 = C).",
          "type": "integer",
          "minimum": 0,
          "maximum": 11
        },
        "quality": {
          "description": "Chord quality, Harte-style shorthand.",
          "type": "string",
          "enum": [
            "maj",
            "min",
            "dim",
            "aug",
            "sus2",
            "sus4",
            "5",
            "maj6",
            "min6",
            "7",
            "maj7",
            "min7",
            "minmaj7",
            "dim7",
            "hdim7",
            "9",
            "maj9",
            "min9",
            "add9"
          ]
        },
        "bass": {
          "description": "Bass pitch class when it differs from the root (slash chord).",
          "type": "integer",
          "minimum": 0,
          "maximum": 11
        },
        "label": {
          "description": "Display label, e.g. \"G\", \"Am7\", \"C/E\".",
          "type": "string",
          "minLength": 1
        }
      }
    },
    "Note": {
      "title": "Note",
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end", "midi", "velocity", "hand", "source"],
      "properties": {
        "start": { "type": "number", "minimum": 0 },
        "end": { "type": "number", "minimum": 0 },
        "midi": { "type": "integer", "minimum": 0, "maximum": 127 },
        "velocity": { "type": "integer", "minimum": 0, "maximum": 127 },
        "hand": { "type": "string", "enum": ["left", "right"] },
        "source": { "type": "string", "enum": ["transcribed", "arranged"] }
      }
    },
    "Section": {
      "title": "Section",
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end", "label"],
      "properties": {
        "start": { "type": "number", "minimum": 0 },
        "end": { "type": "number", "minimum": 0 },
        "label": { "type": "string", "minLength": 1 }
      }
    },
    "Confidence": {
      "title": "Confidence",
      "description": "Pipeline confidence per estimate, 0 to 1.",
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "tempo", "chords"],
      "properties": {
        "key": { "type": "number", "minimum": 0, "maximum": 1 },
        "tempo": { "type": "number", "minimum": 0, "maximum": 1 },
        "chords": { "type": "number", "minimum": 0, "maximum": 1 },
        "notes": {
          "description": "Confidence in the transcribed notes. Optional; added in 0.3.0.",
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "Meta": {
      "title": "Meta",
      "type": "object",
      "additionalProperties": false,
      "required": ["pipelineVersion", "createdAt", "confidence"],
      "properties": {
        "pipelineVersion": { "type": "string", "minLength": 1 },
        "createdAt": { "type": "string", "format": "date-time" },
        "confidence": { "$ref": "#/$defs/Confidence" }
      }
    }
  }
}
